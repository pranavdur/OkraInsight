        "def calculate_relative_yardline(row):\n",
        "    if pd.isna(row['yardline_100']) or pd.isna(row['posteam']) or pd.isna(row['side_of_field']):\n",
        "        return None\n",
        "    if row['posteam'] == row['side_of_field']:\n",
        "        if row['yardline_100'] <= 50:\n",
        "          return row['yardline_100']  # Own side: 1–50\n",
        "        else:\n",
        "          return 100 - row['yardline_100']  # Opponent side: 51–100\n",
        "    else:\n",
        "      if row['yardline_100'] <= 50:\n",
        "        return 50 + (50 - row['yardline_100'])  # Opponent side: 51–100\n",
        "      else:\n",
        "        return row['yardline_100']   # Own side: 1–50\n",
        "\n",
        "\n",
        "df['relative_yardline'] = df.apply(calculate_relative_yardline, axis=1)\n",
        "df = df.drop(columns=['yardline_100', 'side_of_field'])"
      ]
